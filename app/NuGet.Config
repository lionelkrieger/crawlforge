<?xml version="1.0" encoding="utf-8"?>
<!--
  Repo-local NuGet configuration (WP-00-01 scaffold infrastructure).
  The machine's user-level NuGet.Config defines zero package sources, so the repo
  pins the public nuget.org feed explicitly. Build-time package restore only —
  this is tooling, not application runtime traffic (clean-room network boundary).
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
