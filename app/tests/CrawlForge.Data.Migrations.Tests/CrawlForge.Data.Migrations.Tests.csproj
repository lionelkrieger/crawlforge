<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CrawlForge.Data.Migrations.Tests (WP-01-03): live SQLite migration tests via a
    test-local IDbProvider double, plus structural MySQL-dialect parity tests
    (no MySQL server exists on this machine; live parity is exercised in phase 07).
    Central package management is disabled HERE ONLY so the test-local
    Microsoft.Data.Sqlite double can pin its own version (dispatch packet rule);
    the shared CPM pins are mirrored for the test stack. nuget.org only.
  -->
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- DEFECT-11 (D6): live MySQL migration proof against the user-configured
         test server (CF_MYSQL_TEST_*); version mirrors CrawlForge.Data.MySql. -->
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\backend\CrawlForge.Data.Migrations\CrawlForge.Data.Migrations.csproj" />
    <!-- DEFECT D10: report-row parity facts exercise the real provider-switch
         reader (CrawlForge.Data.MySql) against both provider doubles. -->
    <ProjectReference Include="..\..\src\backend\CrawlForge.Data.MySql\CrawlForge.Data.MySql.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Agent-scoped outputs (CF_AGENT_ID): never compile canonical obj/bin artifacts. -->
    <Compile Remove="obj\**" />
    <None Remove="obj\**" />
    <Compile Remove="bin\**" />
    <None Remove="bin\**" />
  </ItemGroup>
</Project>
